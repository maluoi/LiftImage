<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="image/x-lift">
    <comment>Lift Image</comment>
    <acronym>LFI</acronym>
    <expanded-acronym>Lift Image</expanded-acronym>
    <generic-icon name="image-x-generic"/>
    <glob pattern="*.lfi"/>
    <magic priority="50">
      <match type="string" offset="0" value="\x89LFI\r\n\x1a\n"/>
    </magic>
  </mime-type>
</mime-info>
